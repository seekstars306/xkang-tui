# xkang-tui Configuration

# ==============================================================================
# 模式 A: 企业托管模式 (推荐：服务端托管 MCP 核心工具 + LLM 代理，本地零模型密钥)
# ==============================================================================
# 只需要填写公司服务端地址与本项目发放给员工的访问令牌：
XKANG_SERVER_URL=http://localhost:8090
XKANG_TOKEN=tok_dev_001

# 默认基础模型 (服务端统一按该模型路由)
DEFAULT_MODEL=deepseek-v4-flash

# 本地工作目录（客户端本地写文件/改文件工具的沙箱根目录；公司代码检索已统一由服务端执行）
CODE_REPO_PATH=C:\Users\skt\git\skt_cxy

# ==============================================================================
# 模式 B: 本地直连开发模式 (无需 xkang-server)
# ==============================================================================
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# GEMINI_API_KEY=your_gemini_api_key_here
# GROK_API_KEY=your_xai_api_key_here
# GROK_BASE_URL=https://api.x.ai/v1

# ==============================================================================
# 运维脚本凭据（仅 scripts/gitlab_sync.mjs / scripts/test_gitlab.mjs 使用）
# ==============================================================================
# GITLAB_USERNAME=your_gitlab_user
# GITLAB_PASSWORD=your_gitlab_password
