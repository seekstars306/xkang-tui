# xkang-server 配置示例
PORT=8090

# 员工访问令牌列表：格式为 "token1:员工姓名,token2:员工姓名"
XKANG_TOKENS=tok_dev_001:测试员工,tok_tech_002:二线客服A

# 管理员访问令牌列表：用于模型统一切换 (/admin/model)
XKANG_ADMIN_TOKENS=admin_secret_token_123:系统管理员

# 模型状态持久化存储路径（保存当前活跃模型，服务重启不丢失）
ACTIVE_MODEL_PATH=./active_model.json

# 是否开启 Mock 模式（用于无外部 API Key 时的开发测试与在途验证：1 或 true）
# XKANG_LLM_MOCK=1

# 上游模型 API 密钥（仅保存在服务端，永不下发客户端，对员工隐藏真实模型名称）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

GEMINI_API_KEY=your-gemini-api-key
# 显式开启核心模型思考；default仅用于还原未传参数的对照配置
GEMINI_MODEL=gemini-3.8-flash-high
GEMINI_REASONING_EFFORT=high
# 高思考复核两阶段及格式重试共用此总时限（毫秒），可选60000至300000
ANSWER_REVIEW_TIMEOUT_MS=180000
GROK_API_KEY=your-grok-api-key
GROK_BASE_URL=https://api.x.ai/v1

# 公司内部 CodeGraph 拓扑服务地址
CODEGRAPH_ENDPOINT=http://localhost:8080/codegraph

# 允许查询的仓库白名单（英文逗号分隔，* 表示允许全部）
REPO_ALLOWLIST=*

# 公司内部只读数据库配置 (MyCat / MySQL)
COMPANY_DB_HOST=10.197.236.175
COMPANY_DB_PORT=8066
COMPANY_DB_USER=zhangzhao
COMPANY_DB_PASSWORD=your_db_password

# 审计日志落盘路径（默认当前目录 audit.jsonl）
AUDIT_LOG_PATH=./audit.jsonl

# 限流阈值（单个令牌每分钟最大请求次数）
RATE_LIMIT_PER_MINUTE=120

# 代码库根目录（search_code / read_file_lines / git_inspect / codegraph 均基于此目录）
CODE_REPO_PATH=D:/skt_project
# 可选：显式指定哪些一级目录属于前端（英文逗号分隔），默认把名称含 front 的目录视为前端
# CODE_FRONTEND_DIRS=skt-front

# 定时代码同步（会对 CODE_REPO_PATH 下的各仓库执行 git fetch/pull，失败时 reset --hard 到上游）
# 测试/临时实例务必关闭：CODE_SYNC_ENABLED=false 或 CODE_SYNC_INTERVAL_MINUTES=0
CODE_SYNC_INTERVAL_MINUTES=10
# CODE_SYNC_ENABLED=false

# Grafana / Loki 生产日志查询（search_logs / list_log_apps），凭据只放在这里，代码中不再保留默认值
GRAFANA_URL=http://grafana.example:8885
GRAFANA_USERNAME=your_grafana_user
GRAFANA_PASSWORD=your_grafana_password
GRAFANA_LOKI_UID=your_loki_datasource_uid

# 互联网搜索（可选）：配置后才会注册 web_search 工具；未配置时不注册，不会返回任何编造的结果
# SEARCH_API_KEY=your_search_api_key
# SEARCH_API_ENDPOINT=https://api.exa.ai/search
