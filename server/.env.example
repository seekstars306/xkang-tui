# xkang-server 配置示例
PORT=8090

# 员工访问令牌列表：格式为 "token1:员工姓名,token2:员工姓名"
XKANG_TOKENS=tok_dev_001:测试员工,tok_tech_002:二线客服A

# 管理员访问令牌列表：用于模型统一切换 (/admin/model)
XKANG_ADMIN_TOKENS=admin_secret_token_123:系统管理员

# 模型状态持久化存储路径（保存当前活跃模型，服务重启不丢失）
ACTIVE_MODEL_PATH=./active_model.json

# 是否开启 Mock 模式（用于无外部 API Key 时的开发测试与在途验证：1 或 true）
# XKANG_LLM_MOCK=1

# 上游模型 API 密钥（仅保存在服务端，永不下发客户端，对员工隐藏真实模型名称）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

GEMINI_API_KEY=your-gemini-api-key
GROK_API_KEY=your-grok-api-key
GROK_BASE_URL=https://api.x.ai/v1

# 公司内部 CodeGraph 拓扑服务地址
CODEGRAPH_ENDPOINT=http://localhost:8080/codegraph

# 允许查询的仓库白名单（英文逗号分隔，* 表示允许全部）
REPO_ALLOWLIST=*

# 公司内部只读数据库配置 (MyCat / MySQL)
COMPANY_DB_HOST=10.197.236.175
COMPANY_DB_PORT=8066
COMPANY_DB_USER=zhangzhao
COMPANY_DB_PASSWORD=your_db_password

# 审计日志落盘路径（默认当前目录 audit.jsonl）
AUDIT_LOG_PATH=./audit.jsonl

# 限流阈值（单个令牌每分钟最大请求次数）
RATE_LIMIT_PER_MINUTE=120
