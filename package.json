{
  "name": "xkang-tui",
  "version": "1.0.0",
  "description": "Intelligent Customer Service & Troubleshooting Assistant with TUI based on Harness pattern",
  "main": "dist/cli.js",
  "type": "module",
  "bin": {
    "xhang": "dist/cli.js",
    "xkang": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.tsx",
    "build": "tsc",
    "build:exe": "node scripts/build_exe.mjs",
    "start": "node dist/cli.js",
    "web": "tsx web/server.ts",
    "bind": "tsx web/bind.tsx",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "tui",
    "ink",
    "deepseek",
    "gemini",
    "grok",
    "harness",
    "codegraph",
    "agent"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.17.1",
    "@modelcontextprotocol/sdk": "^1.11.0",
    "@vscode/ripgrep": "^1.18.0",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "ink": "^7.1.1",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "mysql2": "^3.23.3",
    "openai": "^7.4.0",
    "react": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "png-to-ico": "^3.0.2",
    "resedit": "^3.0.2",
    "sharp": "^0.35.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
